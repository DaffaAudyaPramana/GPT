{
  "manifest_version": 3,
  "name": "ChatGPT Conversation Booster",
  "version": "2.0.0",
  "description": "Meringankan percakapan ChatGPT yang panjang dengan hanya menampilkan pesan terbaru.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "action": {
    "default_title": "ChatGPT Conversation Booster",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
